{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memora:ingestion:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "findings"
  ],
  "properties": {
    "format": {
      "const": "memora-findings-v1"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "description",
          "body",
          "reason",
          "sources"
        ],
        "properties": {
          "type": {
            "enum": [
              "Concept",
              "Fact",
              "Decision",
              "Idea",
              "Procedure",
              "Document",
              "System",
              "Source"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sources": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resource"
              ],
              "properties": {
                "resource": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "path": {
            "type": "string",
            "pattern": "^/.*\\.md$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "external_refs": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "instance": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "entity_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "entity_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "relation": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "observed_revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "provider",
                "instance",
                "entity_type",
                "entity_id",
                "relation"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
