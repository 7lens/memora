{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memora:note:1.0.0",
  "title": "Memora Markdown frontmatter",
  "type": "object",
  "required": [
    "type",
    "title",
    "description",
    "brain"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "brain": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "state",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "provisional",
            "settled",
            "disputed",
            "discarded",
            "superseded"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "target_id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "target": {
                "type": "string",
                "pattern": "^/.*\\.md$"
              }
            }
          }
        }
      }
    }
  }
}
